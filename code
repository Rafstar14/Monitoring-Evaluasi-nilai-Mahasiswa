using namespace std;

// Konstanta ukuran dimensi array
const int JML_KELAS = 3;
const int JML_MHS = 5;
const int JML_KOMPONEN = 4;
const double EPSILON = 1e-9;

// ==========================================
// FUNGSI UTILITAS & PERHITUNGAN DASAR
// ==========================================

// Mengubah string menjadi huruf kecil untuk pencarian case-insensitive
string keHurufKecil(string teks) {
  for (size_t i = 0; i < teks.length(); i++) {
    if (teks[i] >= 'A' && teks[i] <= 'Z') {
      teks[i] = teks[i] + ('a' - 'A');
    }
  }
  return teks;
}

// Membersihkan buffer input jika pengguna memasukkan karakter non-angka
void bersihkanInput() {
  cin.clear();
  cin.ignore(10000, '\n');
}

// Menentukan grade berdasarkan nilai akhir
char tentukanGrade(double nilaiAkhir) {
  if (nilaiAkhir >= 85.0)
    return 'A';
  else if (nilaiAkhir >= 75.0)
    return 'B';
  else if (nilaiAkhir >= 65.0)
    return 'C';
  else if (nilaiAkhir >= 50.0)
    return 'D';
  else
    return 'E';
}

// Menentukan status kelulusan berdasarkan nilai akhir
string tentukanStatus(double nilaiAkhir) {
  return (nilaiAkhir >= 65.0) ? "LULUS" : "TIDAK LULUS";
}

// Menghitung nilai akhir seluruh mahasiswa dan menyimpannya ke array 2D
// nilaiAkhir
void hitungSemuaNilaiAkhir(const int nilai[JML_KELAS][JML_MHS][JML_KOMPONEN],
                           const double bobot[JML_KOMPONEN],
                           double nilaiAkhir[JML_KELAS][JML_MHS]) {
  for (int k = 0; k < JML_KELAS; k++) {
    for (int m = 0; m < JML_MHS; m++) {
      double total = 0.0;
      for (int c = 0; c < JML_KOMPONEN; c++) {
        total += nilai[k][m][c] * bobot[c];
      }
      nilaiAkhir[k][m] = total;
    }
  }
}

// Helper untuk memilih kelas dengan validasi
int pilihKelas(const string namaKelas[JML_KELAS]) {
  int pilihan;
  cout << "\nPilih Kelas:\n";
  for (int k = 0; k < JML_KELAS; k++) {
    cout << (k + 1) << ". " << namaKelas[k] << "\n";
  }
  cout << "Masukkan pilihan kelas (1-" << JML_KELAS << "): ";
  if (!(cin >> pilihan)) {
    bersihkanInput();
    return -1;
  }
  if (pilihan < 1 || pilihan > JML_KELAS) {
    return -1;
  }
  return pilihan - 1; // Mengembalikan indeks 0-2
}

